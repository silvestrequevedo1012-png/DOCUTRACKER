# --- Application ---
APP_NAME=DocuTrack
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO
UPLOAD_DIR=assets/documents

# --- Database ---
# SQLite (development). Remove this line to use the PostgreSQL values below.
DATABASE_URL=sqlite:///docutrack.db

DB_HOST=localhost
DB_PORT=5432
DB_NAME=docutrack
DB_USER=docutrack_user
DB_PASSWORD=change-me
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Security (Phase 2) ---
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Used only by `python -m database.seed` to create the first administrator.
ADMIN_EMAIL=admin@docutrack.com
ADMIN_PASSWORD=ChangeMe123!

# --- SMTP (used in Phase 5) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DocuTrack <no-reply@example.com>
SMTP_USE_TLS=true
